# Klimaregnskabet API (https://klimaregnskabet.dk/klimaregnskabet-api)
# Obtain a free key by registering name + email. Used by etl/fetch_klimaregnskab.py.
# In GitHub Actions, add this as a repository secret named KLIMAREGNSKAB_API_KEY.
KLIMAREGNSKAB_API_KEY=your_api_key_here

# Datafordeleren (https://datafordeler.dk) — OPTIONAL. Free API key (user account on datafordeler.dk).
# Used by etl/fetch_dawa.py to read kommune boundaries from DAGI (dagi_v001:kommuneinddeling).
# Without it the script uses the open Plandata WFS (same DAGI geometry), then the committed archive.
# In GitHub Actions, add this as a repository secret named DATAFORDELER_API_KEY.
DATAFORDELER_API_KEY=
